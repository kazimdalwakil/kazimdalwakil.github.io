#!/usr/bin/env bash

SRC_BRANCH="master"
DEPLOY_BRANCH="gh-pages"
DEPLOY_DIR="../deploy-tmp"

USAGE_MSG="usage: deploy [-h|--help] [-u|--user] [-s|--src SRC_BRANCH] [-d|--deploy DEPLOY_BRANCH] [--verbose] [--no-push]"

while [[ $# > 0 ]]; do
    key="$1"
    case $key in
        -h|--help) echo $USAGE_MSG; exit 0 ;;
        -u|--user) ;;
        -s|--src) SRC_BRANCH="$2"; shift ;;
        -d|--deploy) DEPLOY_BRANCH="$2"; shift ;;
        --verbose) set -x ;;
        --no-push) NO_PUSH="--no-push" ;;
        *) echo "Option $1 is unknown." >&2; echo $USAGE_MSG >&2; exit 1 ;;
    esac
    shift
done

set -e

echo "Deploying..."
echo "Source branch: $SRC_BRANCH"
echo "Deploy branch: $DEPLOY_BRANCH"

read -r -p "Do you want to proceed? [y/N] " response
if [[ ! $response =~ ^([yY][eE][sS]|[yY])+$ ]]; then
    echo "Aborting."
    exit 1
fi

if ! git diff-index --quiet HEAD --; then
    echo "Uncommitted changes found. Please commit before proceeding."
    git diff-index --name-only HEAD --
    exit 1
fi

if ! test -z "$(git ls-files --exclude-standard --others)"; then
    echo "Untracked files found. Please commit or stash before proceeding."
    git ls-files --exclude-standard --others
    exit 1
fi

git checkout $SRC_BRANCH

export JEKYLL_ENV=production
bundle exec jekyll build --lsi

# Prepare a clean deploy directory (outside the repo working tree)
rm -rf "$DEPLOY_DIR"
mkdir -p "$DEPLOY_DIR"
cp -r _site/* "$DEPLOY_DIR"
touch "$DEPLOY_DIR/.nojekyll"

# Set up deploy branch in a separate worktree so master is never touched
git worktree remove --force gh-pages-worktree 2>/dev/null || true
git branch -D $DEPLOY_BRANCH 2>/dev/null || true
git worktree add -B $DEPLOY_BRANCH gh-pages-worktree $SRC_BRANCH

rm -rf gh-pages-worktree/*
cp -r "$DEPLOY_DIR"/* gh-pages-worktree/
cp "$DEPLOY_DIR/.nojekyll" gh-pages-worktree/

cd gh-pages-worktree
git add -fA
git commit --allow-empty -m "$(git -C .. log -1 --pretty=%B) [ci skip]"
[[ ${NO_PUSH} ]] || git push -f -q origin $DEPLOY_BRANCH
cd ..

git worktree remove --force gh-pages-worktree
rm -rf "$DEPLOY_DIR"

echo "Deployed successfully!"
exit 0